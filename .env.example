# ─── DATABASE ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://okeder:password@localhost:5432/okeder_db
REDIS_URL=redis://localhost:6379/0

# ─── CLERK ──────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# ─── STRIPE ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PCT=0.05

# ─── EVENTBRITE ─────────────────────────────────────────────────────────────
EVENTBRITE_PRIVATE_TOKEN=...

# ─── TELEGRAM ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
BOT_WEBHOOK_URL=https://api.okeder.app/webhooks/telegram
BOT_WEBHOOK_SECRET=...
TELEGRAM_USE_POLLING=true   # true en dev local, false en prod

# ─── WHATSAPP ───────────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...

# ─── OPENAI (embeddings profils comportementaux) ────────────────────────────
OPENAI_API_KEY=sk-...

# ─── APP ────────────────────────────────────────────────────────────────────
APP_ENV=development
API_BASE_URL=http://localhost:8000
PWA_BASE_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000/v1

# ─── WEB (Next.js — préfixe NEXT_PUBLIC_ pour variables exposées au browser) ─
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
